{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:koa:schema:build-record:2",
  "title": "kOA Build Record v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["build_id", "record_version", "created_at", "owner_system", "inputs", "pipeline", "statuses", "stages", "outputs"],
  "properties": {
    "build_id": {"type": "string", "minLength": 1},
    "record_version": {"const": "2.0.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "owner_system": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "interaction_profile": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_refs"],
      "properties": {
        "artifact_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_ref"}},
        "snapshot_refs": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
        "export_manifest_refs": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}}
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline_id", "toolchain"],
      "properties": {
        "pipeline_id": {"type": "string", "minLength": 1},
        "toolchain": {"type": "object", "additionalProperties": {"type": "string"}},
        "source_commit": {"type": "string"},
        "kristal_pin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "tag", "commit", "canonicalization_profile", "canonicalization_version"],
          "properties": {
            "version": {"type": "string"},
            "tag": {"type": "string"},
            "commit": {"type": "string", "minLength": 7},
            "canonicalization_profile": {"type": "string"},
            "canonicalization_version": {"type": "string"},
            "schema_set_digest": {"type": "string"}
          }
        }
      }
    },
    "statuses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compile_status", "validation_status", "recognition_status", "publication_status", "activation_status"],
      "properties": {
        "compile_status": {"enum": ["NOT_STARTED", "RUNNING", "SUCCEEDED", "FAILED", "SKIPPED"]},
        "validation_status": {"enum": ["not_evaluated", "in_review", "validated", "conditionally_validated", "disputed", "rejected", "revoked", "not_applicable"]},
        "recognition_status": {"enum": ["recognized", "conditionally_recognized", "under_review", "disputed", "rejected", "deprecated", "revoked", "not_evaluated", "not_applicable"]},
        "publication_status": {"enum": ["NOT_REQUESTED", "PENDING", "PUBLISHED", "FAILED", "WITHDRAWN", "NOT_APPLICABLE"]},
        "activation_status": {"enum": ["NOT_REQUESTED", "PENDING", "ACTIVE", "FAILED", "ROLLED_BACK", "NOT_APPLICABLE"]}
      }
    },
    "stages": {
      "type": "array",
      "items": {"$ref": "#/$defs/stage_record"}
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["working_outputs", "reference_outputs", "validation_refs", "recognition_refs", "runtime_pack_refs"],
      "properties": {
        "working_outputs": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
        "reference_outputs": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
        "validation_refs": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
        "recognition_refs": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
        "runtime_pack_refs": {"type": "array", "items": {"$ref": "#/$defs/runtime_pack_ref"}},
        "reader_policy_refs": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}}
      }
    },
    "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
    "record_hash": {"$ref": "#/$defs/hash_ref"}
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "artifact_type", "id"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "artifact_type": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "digest": {"type": "string"},
        "locator": {"type": "string"},
        "contract_version": {"type": "string"}
      }
    },
    "runtime_pack_ref": {
      "allOf": [
        {"$ref": "#/$defs/artifact_ref"},
        {
          "type": "object",
          "properties": {
            "source_artifact_status": {"enum": ["working", "under_review", "recognized", "reference", "deprecated", "superseded", "revoked"]}
          }
        }
      ]
    },
    "stage_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "FAIL", "SKIP", "RUNNING"]},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "artifacts_in": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
        "artifacts_out": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
        "reason_codes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "hash_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "value"],
      "properties": {
        "alg": {"type": "string"},
        "value": {"type": "string"}
      }
    }
  }
}
