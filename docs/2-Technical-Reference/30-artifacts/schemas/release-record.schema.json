{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:koa:schema:release-record:2",
  "title": "kOA Release Record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "record_version",
    "created_at",
    "created_by",
    "build_ref",
    "artifacts",
    "channels",
    "publication_status",
    "activation_status",
    "activation_owner",
    "events"
  ],
  "properties": {
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "record_version": {
      "const": "2.0.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "build_ref": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact_ref"
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "publication_status": {
      "enum": [
        "DRAFT",
        "ELIGIBILITY_CHECK",
        "READY",
        "PUBLISHING",
        "PUBLISHED",
        "WITHDRAWN",
        "FAILED",
        "CANCELED"
      ]
    },
    "activation_status": {
      "enum": [
        "NOT_REQUESTED",
        "REQUESTED",
        "STAGING",
        "ACTIVE",
        "PARTIAL",
        "FAILED",
        "ROLLED_BACK",
        "NOT_APPLICABLE"
      ]
    },
    "activation_owner": {
      "type": "string",
      "minLength": 1
    },
    "verification_policy_ref": {
      "type": "string"
    },
    "activation_policy_ref": {
      "type": "string"
    },
    "reader_policy_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "artifact_type",
        "id"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "artifact_type": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "source_artifact_status": {
          "enum": [
            "working",
            "under_review",
            "recognized",
            "reference",
            "deprecated",
            "superseded",
            "revoked"
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "type",
        "actor"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "description": "Deprecated compatibility projection. kOA-Linux Release Set is the authoritative platform release compatibility artifact.",
  "deprecated": true
}
